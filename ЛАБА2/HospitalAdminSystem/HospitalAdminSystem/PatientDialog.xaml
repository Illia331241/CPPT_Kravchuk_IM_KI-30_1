<Window x:Class="HospitalAdminSystem.PatientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування пацієнта" Height="350" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="ПІБ:" Grid.Row="0" Margin="0,5"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Дата народження:" Grid.Row="1" Margin="0,5"/>
        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding BirthDate}"/>

        <TextBlock Text="Діагноз:" Grid.Row="2" Margin="0,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Diagnosis}"/>

        <TextBlock Text="Палата:" Grid.Row="3" Margin="0,5"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Ward}"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,15,0,0">
            <Button Content="Зберегти" Width="80" Click="Save_Click" IsDefault="True"/>
            <Button Content="Скасувати" Width="80" Click="Cancel_Click" IsCancel="True" Margin="5,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>